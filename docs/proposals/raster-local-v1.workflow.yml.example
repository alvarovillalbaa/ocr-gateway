name: Temporary installed raster OCR integration
on:
  create:
permissions:
  contents: read
jobs:
  raster-local:
    if: github.repository == 'alvarovillalbaa/ocr-gateway' && github.event.repository.private == false && github.event.ref_type == 'branch' && github.event.ref == 'qa/ocr-raster-local-20261113-4' && github.ref == 'refs/heads/qa/ocr-raster-local-20261113-4'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      SOURCE_COMMIT: APPROVED_SOURCE_COMMIT
      PYTHONDONTWRITEBYTECODE: '1'
    steps:
      - name: Start bounded owned work
        run: echo "RASTER_STARTED_EPOCH=$(date +%s)" >> "$GITHUB_ENV"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          fetch-depth: 2
          clean: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          package-manager-cache: false
      - name: Actual installed image and scanned PDF OCR
        run: python3 tests/scripts/run-raster-local.py
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        if: always()
        with:
          name: ocr-raster-local-${{ github.run_id }}
          path: ${{ runner.temp }}/ocr-raster-local-${{ github.run_id }}.json
          if-no-files-found: error
          retention-days: 1
