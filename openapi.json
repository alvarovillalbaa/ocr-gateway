{
  "openapi": "3.1.0",
  "info": {
    "title": "OCR Gateway",
    "version": "0.1.0",
    "description": "Self-hosted document parsing. Offsets use document-global UTF-16 code units; citations locate extraction output. Provider and key scope always constrain routing."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/providers": {
      "get": {
        "operationId": "providers",
        "responses": {
          "200": {
            "description": "Scoped provider list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProviderInfo"
                      }
                    }
                  },
                  "required": [
                    "providers"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "499": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/parse": {
      "post": {
        "operationId": "parseDocument",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parsed document and provenance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResult"
                }
              }
            }
          },
          "400": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "499": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Gateway error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "DocumentInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "mimeType": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "dataBase64": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000000
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "url"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "dataBase64"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "dataBase64"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "text"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "dataBase64"
                  ]
                }
              ]
            }
          }
        ]
      },
      "ChunkOptions": {
        "type": "object",
        "properties": {
          "maxCharacters": {
            "type": "integer",
            "minimum": 100,
            "maximum": 100000,
            "default": 1600
          },
          "overlap": {
            "type": "integer",
            "minimum": 0,
            "description": "Less than maxCharacters; default min(160,floor(maxCharacters/10))"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "ParseRequest": {
        "type": "object",
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentInput"
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "single",
              "parallel",
              "fallback"
            ],
            "default": "auto"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "excludeProviders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "tables",
                "images",
                "charts",
                "diagrams",
                "equations"
              ]
            }
          },
          "maxProviders": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 2
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000,
            "default": 120000
          },
          "chunking": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChunkOptions"
              },
              {
                "const": false
              }
            ]
          },
          "providerKeys": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "providerOptions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "includeRaw": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "document"
        ],
        "additionalProperties": false
      },
      "BoundingBox": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "pixel",
              "normalized",
              "point"
            ]
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height",
          "unit"
        ],
        "additionalProperties": false
      },
      "Block": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "heading",
              "table",
              "image",
              "chart",
              "diagram",
              "equation",
              "code",
              "list",
              "unknown"
            ]
          },
          "text": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "citationId": {
            "type": "string"
          },
          "bbox": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "inferred": {
            "type": "boolean"
          },
          "imageBase64": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "mimeType": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "start",
          "end",
          "citationId"
        ],
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "properties": {
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Block"
            }
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "required": [
          "text",
          "blocks"
        ],
        "additionalProperties": false
      },
      "Citation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "blockId": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string"
          },
          "bbox": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "inferred": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "provider",
          "blockId",
          "start",
          "end",
          "quote",
          "inferred"
        ],
        "additionalProperties": false
      },
      "Chunk": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "blockIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pageNumbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "id",
          "text",
          "start",
          "end",
          "blockIds",
          "citationIds",
          "pageNumbers"
        ],
        "additionalProperties": false
      },
      "ParsedDocument": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Page"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Citation"
            }
          },
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chunk"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usage": {
            "type": "object",
            "additionalProperties": true
          },
          "raw": {}
        },
        "required": [
          "id",
          "provider",
          "text",
          "pages",
          "citations",
          "chunks",
          "warnings"
        ],
        "additionalProperties": false
      },
      "RoutingDecision": {
        "type": "object",
        "properties": {
          "router": {
            "type": "string",
            "enum": [
              "explicit",
              "custom",
              "rule",
              "jev",
              "openai-decisions",
              "heuristic"
            ]
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "router",
          "providers",
          "reason"
        ],
        "additionalProperties": false
      },
      "ParseResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "document": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "mimeType"
            ],
            "additionalProperties": false
          },
          "primary": {
            "$ref": "#/components/schemas/ParsedDocument"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParsedDocument"
            }
          },
          "routing": {
            "$ref": "#/components/schemas/RoutingDecision"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "provider",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "durationMs": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "document",
          "primary",
          "results",
          "routing",
          "errors",
          "warnings",
          "durationMs"
        ],
        "additionalProperties": false
      },
      "ProviderInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mimeTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "configured": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "mimeTypes",
          "features",
          "enabled",
          "configured"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
